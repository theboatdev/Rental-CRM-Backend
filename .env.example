PORT=5000
NODE_ENV=development
# Cluster holding the platform DB and one tenant_<id> DB per tenant. A replica set
# (Atlas, or a local one) is needed for transactions. Without it /api/v1 responds 503.
MONGODB_URI=mongodb://localhost:27017
PLATFORM_DB_NAME=platform

# Clerk (same instance as the admin dashboard and tenant app) — see docs/clerk-setup.md.
# Without these keys /api/platform and /api/v1 respond 503.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Origins allowed to present session tokens (comma-separated).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
# Signing secret of the Clerk webhook endpoint for /webhooks/clerk (docs/clerk-setup.md, step 8).
# Without it, members aren't synced from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
# Where invitation links land: the tenant app's sign-up, e.g. http://localhost:3000/sign-up. Clerk's own page when empty.
CLERK_INVITATION_REDIRECT_URL=

# Cloudinary, for document scans, inspection photos, bills and logos (Dashboard → API Keys → "API environment variable").
# Without it, uploads respond 503 and records are saved without files. Free accounts block PDF delivery until
# Settings → Security → "Allow delivery of PDF and ZIP files" is on.
CLOUDINARY_URL=

# Encrypts integration credentials (each tenant's WhatsApp connection) in tenant_secrets: 32 bytes, base64.
# Generate with: openssl rand -base64 32. Without it, WhatsApp can't be connected and digests aren't sent.
# Changing it makes stored connections unreadable; they have to be entered again.
TENANT_SECRETS_KEY=

# Graph API version for the WhatsApp Cloud API (v25.0 when empty).
WHATSAPP_GRAPH_VERSION=

# Behind a load balancer or proxy (Render, Fly, a CDN), set this so the guest portal's rate limits see client IPs:
# true, a number of proxy hops (e.g. 1), or Express's names such as loopback.
TRUST_PROXY=
