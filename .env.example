PORT=5000
NODE_ENV=development
# Cluster holding the platform DB and one tenant_<id> DB per tenant. A replica set
# (Atlas, or a local one) is needed for transactions. Without it /api/v1 responds 503.
MONGODB_URI=mongodb://localhost:27017
PLATFORM_DB_NAME=platform

# Clerk (same instance as the admin dashboard and tenant app) — see docs/clerk-setup.md.
# Without these keys /api/platform and /api/v1 respond 503.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Origins allowed to present session tokens (comma-separated).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
# Signing secret of the Clerk webhook endpoint for /webhooks/clerk (docs/clerk-setup.md, step 8).
# Without it, members aren't synced from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional: where the tenant admin's invitation link lands. Clerk's default sign-up page when empty.
CLERK_INVITATION_REDIRECT_URL=

# AWS S3 Storage for Documents & Photos
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=shenaly-car-rental-docs

# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_WEEKLY_DIGEST_RECIPIENT=+94770000000
